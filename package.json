{
  "name": "chronosprint",
  "version": "1.0.0",
  "private": true,
  "description": "ChronoSprint Pro - Spaced Repetition Calendar (Android app)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o www/app.css --minify",
    "build:js": "esbuild src/native.js --bundle --minify --format=iife --outfile=www/native.js",
    "build:html": "node scripts/build-html.mjs",
    "build": "npm run build:html && npm run build:css && npm run build:js",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "3.4"
  }
}
